{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node", "svelte", "vite-plus/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "test/**/*.ts", "tooling/**/*.ts", "vite.config.ts"]
}
