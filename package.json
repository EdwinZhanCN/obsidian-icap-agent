{
  "name": "icap-agent",
  "version": "1.1.1",
  "private": true,
  "description": "ICAP-based learning agent for Obsidian: explanations, recall and interaction inside your Markdown notes.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "npm run build:css && node esbuild.config.mjs --production",
    "build:css": "tailwindcss -i src/styles/main.css -o styles.css --minify",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "vault": "node scripts/dev-vault.mjs",
    "test": "vitest --run"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@tailwindcss/cli": "^4.3.4",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "obsidian": "^1.14.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@lucide/svelte": "^1.67.0",
    "fflate": "0.8.3",
    "motion": "^14.9.0"
  }
}
