{
  "name": "icap-agent",
  "version": "1.1.4",
  "private": true,
  "description": "ICAP-based learning agent for Obsidian: explanations, recall and interaction inside your Markdown notes.",
  "type": "module",
  "scripts": {
    "dev": "vp build --watch --mode development",
    "build": "vp build",
    "check": "vp check && svelte-check --tsconfig ./tsconfig.json",
    "vault": "node scripts/dev-vault.mjs",
    "test": "vp test --run",
    "test:unit": "vp test --run --project unit",
    "test:integration": "vp test --run --project integration"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "happy-dom": "^21.0.4",
    "obsidian": "1.14.4",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1",
    "vite-plus": "1.5.1"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@lucide/svelte": "1.67.0",
    "fflate": "0.8.3",
    "motion": "14.9.0",
    "typebox": "1.3.27",
    "undici": "8.12.3"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.19.0"
  }
}
