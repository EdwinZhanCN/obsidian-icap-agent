// The docs site on Cloudflare: Workers static assets (no Worker code), served from dist/ at
// icap.edwinzhan.space. Deploy: pnpm run deploy (builds first).
{
	"name": "icap-site",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	"routes": [{ "pattern": "icap.edwinzhan.space", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false
}
